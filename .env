# Configuracion del sistema.

# Limites por tipo de paquete
LIMITE_NORMAL_PESO_KG_MAX=30
LIMITE_NORMAL_ALTO_CM_MAX=60
LIMITE_NORMAL_ANCHO_CM_MAX=60
LIMITE_NORMAL_LARGO_CM_MAX=80

LIMITE_FRAGIL_PESO_KG_MAX=8
LIMITE_FRAGIL_ALTO_CM_MAX=40
LIMITE_FRAGIL_ANCHO_CM_MAX=40
LIMITE_FRAGIL_LARGO_CM_MAX=50

# Capacidad de la cinta
CINTA_ID=C1
CINTA_CAPACIDAD_KG=100

# Ventana de carrera del camino sin transaccion.
VENTANA_CARRERA_S=0.15
TIMEOUT_ADMISION_S=15

# UT4 - Throttling por cliente.
THROTTLE_TASA=20r/s
THROTTLE_RAFAGA=40

# UT4 - Health Endpoint Monitoring.
TIMEOUT_SALUD_S=2
MONITOR_INTERVALO_S=2
MONITOR_TIMEOUT_S=4

# UT4 - Queue-Based Load Leveling (rendimiento).
# Publicacion persistente, consumo en paralelo y pileta de base mas grande
# para que las rafagas no dejen caer conexiones.
HILOS_MAX=64
HILOS_DB=100
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT_S=30
COLA_CONSUMIDORES=8
COLA_PREFETCH=1

# UT4 - Cache-Aside (Rendimiento).
CACHE_HABILITADA=true
CACHE_TTL_S=5

# UT4 - Gatekeeper (Seguridad).
CLAVE_INTERNA=cinta-interna-dev

# UT4 - Gateway Offloading (Seguridad).
API_KEYS_VALIDAS=cliente-alpha,cliente-beta,cliente-operador
ENFORCE_API_KEY=false

